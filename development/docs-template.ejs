<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= headerText %> - TurboWarp 扩展文档</title>
    <link rel="canonical" href="https://extensions.wwh.dpdns.org/<%= slug %>">
    <style>
      :root {
        font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
        color-scheme: light dark;
        font-size: 16px;
        --bg: #f7f8fa;
        --fg: #2c3e50;
        --card: #ffffff;
        --border: #e4e7ec;
        --muted: #6b7280;
        --accent: #ff4c4c;
        --link: #2f6fdb;
        --link-visited: #8a4fd6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #131313;
          --fg: #eee;
          --card: #1c1c1e;
          --border: #2e2e30;
          --muted: #9ca3af;
          --link: #56b2ff;
          --link-visited: #f192ff;
        }
        a:active { color: red; }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 0;
        line-height: 1.65;
        background: var(--bg);
        color: var(--fg);
      }

      a { color: var(--link); text-decoration: none; }
      a:visited { color: var(--link-visited); }
      a:hover { text-decoration: underline; }

      nav {
        background: var(--accent);
        color: white;
        font-weight: 600;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .1);
      }
      @media (prefers-color-scheme: dark) {
        nav { background: #252527; }
      }
      nav > div {
        display: flex;
        max-width: 760px;
        margin: 0 auto;
        padding: 0 20px;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      nav a {
        display: inline-flex;
        gap: 0.5rem;
        padding: 0.75rem 0;
        align-items: center;
        text-decoration: none;
        color: inherit !important;
        font-size: 1rem;
      }
      nav a:hover { text-decoration: underline; }

      noscript {
        display: block;
        padding: 12px 16px;
        background: rgba(255, 193, 7, 0.15);
        border-left: 4px solid #ffc107;
        border-radius: 4px;
        font-weight: 600;
        color: #665200;
        margin: 16px 0;
      }

      .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 28px 20px 60px;
      }

      h1 {
        font-size: 2rem;
        margin: 0 0 24px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--border);
        letter-spacing: -0.02em;
      }
      h2 {
        font-size: 1.4rem;
        margin: 32px 0 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--border);
      }
      h3 {
        font-size: 1.15rem;
        margin: 24px 0 8px;
      }
      h4, h5, h6 {
        font-size: 1rem;
        margin: 20px 0 8px;
        border: none;
      }

      p { margin: 12px 0; }
      ul, ol { padding-left: 1.5em; }
      li { margin: 4px 0; }

      hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 32px 0;
      }

      .view-in-browser { display: none; }
      .is-desktop .view-in-browser { display: inline-flex; }
      .is-desktop nav > div,
      .is-desktop .container { max-width: 100%; }

      code {
        background: rgba(120, 130, 150, 0.12);
        border-radius: 4px;
        padding: 0.15em 0.4em;
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.9em;
      }
      pre {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 14px 16px;
        overflow-x: auto;
        line-height: 1.5;
      }
      pre code {
        background: none;
        padding: 0;
        border-radius: 0;
      }

      blockquote {
        margin: 16px 0;
        padding: 8px 16px;
        border-left: 4px solid var(--border);
        color: var(--muted);
      }

      table {
        border-collapse: collapse;
        width: 100%;
        margin: 16px 0;
        font-size: 0.95em;
      }
      th, td {
        border: 1px solid var(--border);
        padding: 8px 12px;
        text-align: left;
      }
      th {
        background: rgba(120, 130, 150, 0.08);
        font-weight: 600;
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
      }

      .render-scratchblocks {
        width: 100%;
        overflow-x: auto;
        white-space: pre;
        line-height: 42px;
        margin: 16px 0;
      }
      .render-scratchblocks svg { display: block; }

      footer {
        margin: 40px 0 0;
        padding-top: 16px;
        border-top: 1px solid var(--border);
        font-size: 0.875rem;
        color: var(--muted);
      }
      footer p { margin: 6px 0; }

      /* Alerts */
      .alert {
        padding: 2px 16px;
        margin: 16px 0;
        border-left: 4px solid var(--border);
        border-radius: 4px;
        background: var(--card);
        line-height: 1.5;
      }
      .alert.alert-note     { border-left-color: #1f6feb; background: rgba(31, 111, 235, 0.06); }
      .alert.alert-tip      { border-left-color: #238636; background: rgba(35, 134, 54, 0.06); }
      .alert.alert-important{ border-left-color: #8957e5; background: rgba(137, 87, 229, 0.06); }
      .alert.alert-warning  { border-left-color: #9e6a03; background: rgba(158, 106, 3, 0.06); }
      .alert.alert-caution  { border-left-color: #da3633; background: rgba(218, 54, 51, 0.06); }

      .alert p:first-child {
        padding-top: 10px;
        margin-bottom: 4px;
        font-weight: 600;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      .alert.alert-note > p:first-child      { color: #4493f8; }
      .alert.alert-tip > p:first-child       { color: #3fb950; }
      .alert.alert-important > p:first-child { color: #ab7df8; }
      .alert.alert-warning > p:first-child   { color: #d29922; }
      .alert.alert-caution > p:first-child   { color: #f85149; }

      .alert svg {
        margin-right: 8px;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <nav role="navigation">
      <div>
        <a href="https://extensions.wwh.dpdns.org/">
          <span>我的 TurboWarp 扩展</span>
        </a>

        <!-- Only used by desktop app -->
        <a class="view-in-browser" href="https://extensions.wwh.dpdns.org/<%= slug %>">
          在浏览器中打开
        </a>
      </div>
    </nav>

    <main class="container">
      <h1><%- headerHTML %></h1>

      <noscript><p>请启用 JavaScript 以渲染积木块。</p></noscript>

      <%- bodyHTML %>

      <footer>
        <p>
          本页为 <a href="https://github.com/wangwenhao20211/turbowarp-extensions/tree/master/docs">开源</a>内容。
          <% if (usesScratchBlocks) { %>
            积木块由 <a href="https://scratchblocks.github.io/">scratchblocks</a> 渲染。
          <% } %>
        </p>
        <p>本站是个人维护的 TurboWarp 扩展站点，与 Scratch、Scratch Team、Scratch Foundation 均无关联。</p>
      </footer>
    </main>

    <% if (usesScratchBlocks) { %>
      <script src="/docs-internal/scratchblocks.js"></script>
      <script>
        scratchblocks.renderMatching('.render-scratchblocks', {
          style: 'scratch3'
        });
      </script>
    <% } %>
  </body>
</html>